{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on Monday"],
  "timezone": "UTC",
  "dependencyDashboard": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Group Go minor and patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies (minor/patch)"
    },
    {
      "description": "Automerge GitHub Actions minor, patch, and digest updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Group Dockerfile base image updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Dockerfile base images"
    },
    {
      "description": "Require dashboard approval for all major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
